[Unit]
Description=Biscuit Trocador relay
After=network-online.target
Wants=network-online.target

[Service]
# Replace relay.example.org and the age1... public key.
ExecStart=/usr/local/bin/biscuit-relay serve \
    -domain relay.example.org \
    -key-file %d/trocador-key \
    -recipient age1REPLACE_WITH_PUBLIC_KEY \
    -log-dir /var/lib/biscuit-relay/trades \
    -cert-dir /var/lib/biscuit-relay/certs
# The Trocador key is handed to the service only, never readable by other users.
LoadCredential=trocador-key:/etc/biscuit-relay/trocador-key
Restart=always
RestartSec=5

DynamicUser=yes
StateDirectory=biscuit-relay
StateDirectoryMode=0700
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
