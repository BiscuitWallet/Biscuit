<!-- What app stores and software centers show about Biscuit (AppStream). -->
<component type="desktop-application">
  <id>com.biscuitwallet.Biscuit</id>
  <name>Biscuit</name>
  <summary>Private multi-crypto desktop wallet</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>BSD-3-Clause AND GPL-3.0-only</project_license>

  <developer id="com.biscuitwallet">
    <name>The Biscuit developers</name>
  </developer>

  <description>
    <p>
      Biscuit is a private and modern multi-crypto desktop wallet, Monero first,
      in one window, with one password. It is built on Feather Wallet and keeps
      its simple, fast interface.
    </p>
    <!-- The coins: update this line (and the keywords) when a release adds one. -->
    <p>Coins: Monero, Bitcoin, Litecoin, Dogecoin, Ethereum and Arbitrum (ETH, USDT, USDC) and Solana. Every coin besides Monero is optional.</p>
    <ul>
      <li>Swap between your coins through exchanges that never ask for identity, ranked only by what you receive. Biscuit adds no fee.</li>
      <li>Swaps work in Tor mode too, through Biscuit's onion service.</li>
      <li>Atomic swaps from Bitcoin to Monero, with no exchange in the middle.</li>
      <li>Tor if you want it: everything goes through Tor once it is on.</li>
      <li>Your own nodes and servers if you want them.</li>
      <li>No telemetry, no analytics, no account.</li>
    </ul>
  </description>

  <launchable type="desktop-id">biscuit.desktop</launchable>
  <provides>
    <binary>biscuit</binary>
  </provides>

