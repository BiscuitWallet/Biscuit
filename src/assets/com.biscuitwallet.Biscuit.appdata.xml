<!-- What app stores and software centers show about Biscuit (AppStream). -->
<component type="desktop-application">
  <id>com.biscuitwallet.Biscuit</id>
  <name>Biscuit</name>
  <summary>Light desktop wallet for Monero, Bitcoin and Litecoin</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>BSD-3-Clause AND GPL-3.0-only</project_license>

  <developer id="com.biscuitwallet">
    <name>The Biscuit developers</name>
  </developer>

  <description>
    <p>
      Biscuit is a light desktop wallet for Monero, Bitcoin and Litecoin, in one
      window, with one password. It is based on Feather Wallet and keeps its
      simple, fast interface.
    </p>
    <ul>
      <li>Your keys never leave your computer, and every send waits for your confirmation.</li>
      <li>Swap between your coins through exchanges, ranked only by what you receive. Biscuit adds no fee.</li>
      <li>Atomic swaps from Bitcoin to Monero, with no exchange in the middle.</li>
      <li>Tor if you want it: everything goes through Tor once it is on.</li>
      <li>Your own nodes and servers if you want them.</li>
      <li>No telemetry, no analytics, no account.</li>
    </ul>
  </description>

  <launchable type="desktop-id">biscuit.desktop</launchable>
  <provides>
    <binary>biscuit</binary>
  </provides>

